# Copie este arquivo para bot/.env e cole os valores reais.
# bot/.env está no .gitignore e nunca entra no repositório.

TELEGRAM_TOKEN=cole_aqui_o_token_do_BotFather

# A conversa livre com IA. Sem esta chave o bot sobe igual, só responde pelo
# caminho determinístico. Com ela, pergunta solta vai para o Claude com as
# ferramentas que leem o motor.
# ANTHROPIC_API_KEY=

# Teto de gasto da conversa livre. Os padrões são estes, só mexa se precisar.
# REGIS_LIMITE_HORA=20
# REGIS_TETO_USD=5.00
